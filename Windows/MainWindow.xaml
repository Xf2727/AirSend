<Window x:Class="AirSend.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirSend" Width="620" Height="460" MinWidth="520" MinHeight="360" Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="AirSend" FontSize="30" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
            <Button Content="刷新设备" Width="110" Height="32" Click="Refresh_Click" />
            <Button Content="选择文件并发送" Width="140" Height="32" Margin="10,0,0,0" Click="Send_Click" />
            <TextBlock x:Name="StatusText" Margin="14,7,0,0" Foreground="#666" />
        </StackPanel>
        <ListView x:Name="DeviceList" Grid.Row="2" ItemsSource="Devices" BorderBrush="#DDD" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="设备名称" Width="230" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="地址" Width="150" DisplayMemberBinding="{Binding Address}" />
                    <GridViewColumn Header="端口" Width="90" DisplayMemberBinding="{Binding Port}" />
                    <GridViewColumn Header="协议" Width="90" DisplayMemberBinding="{Binding Protocol}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock x:Name="DetailText" Grid.Row="3" Margin="0,14,0,0" Foreground="#666" />
    </Grid>
</Window>
